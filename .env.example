# STRIDE Environment Variables

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Ask Coach UI. Core coaching works with this disabled.
EXPO_PUBLIC_ENABLE_ASK_COACH=false
# Your optional Node backend URL; never put a Gemini key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_COACH_API_URL=http://localhost:8787
